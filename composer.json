{
    "name": "sprunka/outgunned-character-builder",
    "description": "Character Builder for Outgunned",
    "license": "MIT",
    "authors": [
        {
            "name": "Sean Prunka",
            "email": "sprunka@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/sprunka/CommonRoutes"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "slim/slim": "^4.5",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "selective/basepath": "^2.1",
        "zircote/swagger-php": "^4.7",
        "fakerphp/faker": "^1.15",
        "sprunka/common-routes": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Outgunned\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Outgunned\\Test\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    }
}